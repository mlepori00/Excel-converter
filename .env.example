# Backend configuration. Copy to .env and fill in. The .env file is gitignored.

# Anthropic API key for AI extraction (Haiku). Required.
ANTHROPIC_API_KEY=sk-ant-...

# Secret used to sign login JWTs. REQUIRED in production – set a long random
# value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# If unset, an insecure dev fallback is used (local only, see APP_ENV).
SECRET_KEY=

# Environment mode. "dev"/"local"/"test" allow an ephemeral fallback key when
# SECRET_KEY is unset; any other value (e.g. "production") makes a missing
# SECRET_KEY a hard startup error. The Docker image already sets APP_ENV=production.
# APP_ENV=dev

# Optional: SQLAlchemy database URL. Defaults to a local SQLite file at
# ./data/offerten.db. Override to point elsewhere (or to Postgres later).
# DATABASE_URL=sqlite:///./data/offerten.db

# Optional: access-token lifetime in minutes (default 720 = 12h).
# ACCESS_TOKEN_TTL_MINUTES=720

# CORS allowed origins. Comma-separated list of allowed frontend origins.
# REQUIRED in production – set to your server's domain (e.g. https://amp.example.com).
# If unset, all origins are allowed (local dev only).
# ALLOWED_ORIGINS=https://amp.example.com
